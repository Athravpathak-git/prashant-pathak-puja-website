# Dedicated PostgreSQL Connection for Prashant Pathak Puja Database
DATABASE_URL=postgresql://prashant_pathak_app:YOUR_PASSWORD@localhost:5432/prashant_pathak_puja_db

# Security & Sessions
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_characters

# Dedicated Server-Only Encryption Key for WhatsApp Direct Chat (AES-256-GCM)
# Note: Zero setup required out of the box! If omitted, automatically derives a secure key from JWT_SECRET.
# For custom key, provide a 32+ character random string or 64-character hex key:
# WHATSAPP_ENCRYPTION_KEY=your_secure_server_only_whatsapp_encryption_key_here

# Default Admin Seed Credentials (changed upon initial setup)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=YourSecurePasswordHere!

# Public Identity
WHATSAPP_PUBLIC_USERNAME=@PrashantPathakGuruji
NEXT_PUBLIC_WHATSAPP_USERNAME=@PrashantPathakGuruji
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Optional Persistent Cloud Media Storage (Cloudinary / Vercel Blob)
# Note: Zero setup required out of the box! Uploads automatically persist safely
# in the dedicated PostgreSQL database. Optionally configure Cloudinary or Vercel Blob
# for CDN-backed high-speed media delivery:
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Optional AI/Cloud Translation Configuration (Automatic Marathi-to-English translation in Admin Panel)
# Note: The system automatically uses MyMemory Translation with Vedic terminology enhancement out of the box with zero setup.
# You can optionally provide Google Gemini or Google Cloud Translation keys for enhanced AI translation:
# GEMINI_API_KEY=your_google_gemini_api_key_here
# GOOGLE_TRANSLATE_API_KEY=your_google_cloud_translate_api_key_here

