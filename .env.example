# Dedicated PostgreSQL Connection for Prashant Pathak Puja Database
DATABASE_URL=postgresql://prashant_pathak_app:YOUR_PASSWORD@localhost:5432/prashant_pathak_puja_db

# Security & Sessions
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_characters

# Default Admin Seed Credentials (changed upon initial setup)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=YourSecurePasswordHere!

# Public Identity
WHATSAPP_PUBLIC_USERNAME=@PrashantPathakGuruji
NEXT_PUBLIC_WHATSAPP_USERNAME=@PrashantPathakGuruji
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environment
NODE_ENV=development
